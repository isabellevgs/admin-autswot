# Ambiente (development, production)
VITE_ENV=development

# URL da API (same-origin via proxy Vite em dev e Nginx em produção)
VITE_API_URL=/api

# Timeout das requisições (em ms)
VITE_API_TIMEOUT=10000

# Coolify — domínio do painel admin (gera certificado Let's Encrypt na origem)
SERVICE_FQDN_ADMIN=https://painel.autswot.com
